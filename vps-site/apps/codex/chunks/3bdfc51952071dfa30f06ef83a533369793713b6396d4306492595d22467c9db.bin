/^(export|declare -x|typeset -x) [A-Za-z_][A-Za-z0-9_]*$/ {
  name=$0
  sub(/^(export|declare -x|typeset -x) /, "", name)
  if (name ~ /^(PWD|OLDPWD)$/) {
    next
  }
  if (!seen[name]++) {
    print name
