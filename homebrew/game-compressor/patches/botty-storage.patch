+// Botty accepts only managed payload roots on genuinely mounted exFAT media.
+static int botty_root(const char *path) {
+  if(!strcmp(path,"/data/botty")) return 1;
+  if(strlen(path)!=15 || strncmp(path,"/mnt/usb",8) || path[8]<'0' || path[8]>'7' || strcmp(path+9,"/botty")) return 0;
+  char mount[16];snprintf(mount,sizeof(mount),"/mnt/usb%c",path[8]);
+  struct statfs fs;
+  if(statfs(mount,&fs) || strcmp(fs.f_mntonname,mount) || (fs.f_flags&MNT_RDONLY)) return 0;
+  if(strcmp(fs.f_fstypename,"exfatfs") && strcmp(fs.f_fstypename,"exfat")) return 0;
+  struct stat st;
+  return !lstat(path,&st) && S_ISDIR(st.st_mode);
+}
+static int botty_source(const char *path) {
+  const char *leaf=NULL;
+  if(!strncmp(path,"/data/homebrew/",15)) leaf=path+15;
+  else if(!strncmp(path,"/mnt/usb",8) && path[8]>='0' && path[8]<='7' && !strncmp(path+9,"/homebrew/",10)) {
+    char root[32];snprintf(root,sizeof(root),"/mnt/usb%c/botty",path[8]);
+    if(!botty_root(root)) return 0;
+    char parent[32];snprintf(parent,sizeof(parent),"/mnt/usb%c/homebrew",path[8]);
+    struct stat st;if(lstat(parent,&st)||!S_ISDIR(st.st_mode)) return 0;
+    leaf=path+19;
+  }
+  return leaf && *leaf && !strchr(leaf,'/') && !strstr(leaf,"..") && !strchr(leaf,'\\');
+}
