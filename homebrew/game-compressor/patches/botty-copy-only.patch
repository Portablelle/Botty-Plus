+botty_compress_copy(gc_operation_t *op) {
+  pfs_app_info_t info = {0};
+  pfs_compress_plan_t *plan = NULL;
+  char err[256] = {0};
+  const char *out = "/data/botty/compressor/output/PPSA23732.ffpfsc";
+  struct stat st;
+  char running[64] = {0};
+  int running_state = get_running_big_app(running, sizeof(running), NULL);
+  if(running_state < 0 || (running_state > 0 && strcmp(running, "PPSA99071"))) {
+    snprintf(op->error, sizeof(op->error), "Close the running game before compression");
+    return -1;
+  }
+  if(strcmp(op->source_path, "/data/homebrew/PPSA23732-app") ||
+     lstat(op->source_path, &st) || !S_ISDIR(st.st_mode)) {
+    snprintf(op->error, sizeof(op->error), "Original LEGO folder is unavailable");
+    return -1;
+  }
+  if(mkdirs("/data/botty/compressor/output") != 0) {
+    snprintf(op->error, sizeof(op->error), "Cannot create private output directory");
+    return -1;
+  }
+  snprintf(op->delete_policy, sizeof(op->delete_policy), "keep");
+  snprintf(op->format, sizeof(op->format), "exfat");
+  snprintf(op->output_path, sizeof(op->output_path), "%s", out);
+  job_set_phase("scanning", 0, 0, "Measuring LEGO; original is kept");
+  int rc = pfs_compress_prepare_source_to_ffpfsc_opts_output_ex(
+      op->source_path, 0, PFS_COMPRESS_FORMAT_EXFAT, PFS_DELETE_KEEP, 0,
+      out, NULL, &plan, &info, err, sizeof(err));
+  uint64_t available = 0;
+  if(rc == 0 && (space_for_path("/data/botty/compressor/output", &available, NULL) ||
+      info.scan_bytes > UINT64_MAX - 1073741824ULL ||
+      available < info.scan_bytes + 1073741824ULL)) {
+    snprintf(err, sizeof(err), "Not enough space to keep the original plus a 1 GiB reserve");
+    rc = -1;
+  }
+  if(rc == 0) {
+    operation_store_scan_stats(op, &info);
+    op->compression_source_size = info.scan_bytes;
+    job_set_phase("compressing", 0, info.scan_bytes, "Creating compressed copy; original is kept");
+    rc = pfs_compress_execute_prepared_to_ffpfsc(plan, 2, &info, err, sizeof(err));
+  }
+  pfs_compress_plan_free(plan);
+  if(rc != 0) {
+    snprintf(op->error, sizeof(op->error), "%s", err[0] ? err : "Compression failed");
+    return -1;
+  }
+  operation_store_compression_stats(op, op->compression_source_size, out);
+  snprintf(op->result, sizeof(op->result), "copy-created-unverified");
+  return 0;
+}
