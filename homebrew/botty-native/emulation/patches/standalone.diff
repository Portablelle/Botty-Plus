+ {"Freecam speed",2,6,{{{"1","1"},{"2","2"},{"5","5"},{"10","10"},{"15","15"},{"20","20"}}}},
+ {"Sequence smoothing",1,3,{{{"0.1","0.1"},{"0.25","0.25"},{"0.5","0.5"}}}},
+ {"Animation fadeout",1,2,{{{"Off","Off"},{"On","On"}}}},
+ {"Benchmark location",0,3,{{{"Kakariko","0"},{"Korok Forest","1"},{"Zora Domain","3"}}}},
