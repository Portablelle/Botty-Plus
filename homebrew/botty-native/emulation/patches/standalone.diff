-    if (name.size() < 5 || name.size() > 255) return false;
-    for (unsigned char c : name)
-        if (c < 32 || c == 127 || c == '/' || c == '\\') return false;
+    // Botty publishes complete games atomically under one owned batch directory.
+    if (name.starts_with(".botty-batch-")) {
+        const auto slash = name.find('/');
+        if (slash != 45 || name.find('/', slash + 1) != std::string_view::npos) return false;
+        for (char c : name.substr(13, 32))
+            if (!((c >= 'a' && c <= 'f') || (c >= '0' && c <= '9'))) return false;
+        name.remove_prefix(slash + 1);
+    }
+    if (name.size() < 5 || name.size() > 4096 || name.front() == '/' || name.back() == '/') return false;
+    unsigned components = 0;
+    for (std::string_view rest = name; !rest.empty();) {
+        const auto slash = rest.find('/');
+        const auto part = rest.substr(0, slash);
+        if (++components > 12 || part.empty() || part == "." || part == ".." || part.size() > 255) return false;
+        for (unsigned char c : part) if (c < 32 || c == 127 || c == '\\') return false;
+        if (slash == std::string_view::npos) break;
+        rest.remove_prefix(slash + 1);
+    }
     std::string extension(name.substr(name.size() - 4));
     for (char& c : extension) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
     return extension == ".nsp" || extension == ".xci";
