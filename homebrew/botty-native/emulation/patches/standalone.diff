+struct Stage {
+ fs::path path;bool preserve=false;
+ ~Stage(){if(!preserve&&!path.empty()){std::error_code ec;fs::remove_all(path,ec);}}
+};
+inline fs::path TemporaryDirectory(const fs::path& parent) {
+ Directory(parent);auto pattern=(parent/".botty-ultracam-XXXXXX").string();
+ std::vector<char> name(pattern.begin(),pattern.end());name.push_back(0);
+ const auto made=mkdtemp(name.data());if(!made)throw std::runtime_error("Cannot stage UltraCam");return made;
+}
+inline bool Save(uint64_t title,std::string_view version,const Options& values,std::string& error,
