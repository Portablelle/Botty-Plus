+int eden_game_effective_version(const char* rom_path,const char* keys_dir,uint64_t title_id,char* out,size_t capacity) {
+    if(!out||!capacity)return 0;
+    out[0]='\0';
+    try {
+        if(!rom_path||!keys_dir)return 0;
+        // Advanced update-selection overrides are not managed by this panel.
+        // Refuse approval rather than assume the newest installed patch is active.
+        for(const auto& name:Eden::LoadDisabledMods(title_id))
+            if(name=="Update"||name.starts_with("Update@")||name=="Update (NAND)"||name=="Update (SDMC)"){
+                std::snprintf(out,capacity,"update disabled in game settings");return 0;
+            }
+        Common::FS::SetEdenPath(Common::FS::EdenPath::KeysDir,keys_dir);
+        FileSys::RealVfsFilesystem vfs;
+        auto file=vfs.OpenFile(rom_path,FileSys::OpenMode::Read);
+        if(!file)return 0;
+        std::string ext=std::filesystem::path(rom_path).extension().string();
+        std::transform(ext.begin(),ext.end(),ext.begin(),[](unsigned char c){return std::tolower(c);});
+        std::shared_ptr<FileSys::NCA> base;
+        FileSys::VirtualDir base_control,packed_control;
+        FileSys::VirtualFile packed_raw;
+        const auto packed=[&](const FileSys::NSP& package){
+            packed_control=PackedUpdateControl(package);
+            // Match AppLoader_NSP/XCI::ReadUpdateRaw, including its default title type.
+            packed_raw=package.GetNCAFile(FileSys::GetUpdateTitleID(title_id),FileSys::ContentRecordType::Program);
+            if(packed_raw&&FileSys::NCA(packed_raw).GetStatus()!=Loader::ResultStatus::ErrorMissingBKTRBaseRomFS)packed_raw=nullptr;
+        };
+        if(ext==".xci"){
+            FileSys::XCI image(file);if(image.GetStatus()!=Loader::ResultStatus::Success)return 0;
+            base=image.GetNCAByType(FileSys::NCAContentType::Program);
+            base_control=ExtractControl(image.GetNCAByType(FileSys::NCAContentType::Control));
+            if(const auto secure=image.GetSecurePartitionNSP())packed(*secure);
+        }else{
+            FileSys::NSP package(file);if(package.GetStatus()!=Loader::ResultStatus::Success)return 0;
+            base=package.GetNCA(title_id,FileSys::ContentRecordType::Program);
+            base_control=ExtractControl(package.GetNCA(title_id,FileSys::ContentRecordType::Control));packed(package);
+        }
+        if(!base||base->GetStatus()!=Loader::ResultStatus::Success||base->GetTitleId()!=title_id)return 0;
+        FileSys::VirtualFile selected=packed_raw;
+        FileSys::VirtualDir selected_control=packed_raw?packed_control:base_control;
+        const FileSys::ExternalContentProvider provider({vfs.OpenDirectory(Eden::AssetsPath("updates"),FileSys::OpenMode::Read)});
+        const auto update_id=FileSys::GetUpdateTitleID(title_id);
+        const auto versions=provider.ListUpdateVersions(update_id);
+        if(!versions.empty()){
+            // Same external-first, newest-enabled Program selection as PatchManager.
+            selected=provider.GetEntryForVersion(update_id,FileSys::ContentRecordType::Program,versions.front().version);
+            if(!selected)return 0;
+            const auto control=provider.GetEntryForVersion(update_id,FileSys::ContentRecordType::Control,versions.front().version);
+            selected_control=control?ExtractControl(std::make_shared<FileSys::NCA>(control)):FileSys::VirtualDir{};
+        }
+        if(selected){
+            const FileSys::NCA applied(selected,base.get());
+            if(applied.GetStatus()!=Loader::ResultStatus::Success||!applied.GetExeFS()||!applied.GetRomFS())return 0;
+        }
+        const auto version=selected_control?ReadVersion(selected_control):std::string{};
+        std::snprintf(out,capacity,"%s",version.c_str());return !version.empty();
+    }catch(const std::exception&){return 0;}
+}
