+ {"Quality improvements",1,2,{{{"Off","Off"},{"On","On"}}}},
+ {"Render distance",3,4,{{{"Very low","1000"},{"Low","5000"},{"Medium","12500"},{"Default","25000"}}}},
+ {"Field of view",2,8,{{{"40","40"},{"45","45"},{"50","50"},{"55","55"},{"60","60"},{"70","70"},{"80","80"},{"90","90"}}}},
+ {"Free camera",0,2,{{{"Off","Off"},{"On","On"}}}},
+ {"Menu FPS",2,5,{{{"30","30"},{"40","40"},{"60","60"},{"90","90"},{"120","120"}}}},
+ {"Hide UI in freecam",1,2,{{{"Off","Off"},{"On","On"}}}},
