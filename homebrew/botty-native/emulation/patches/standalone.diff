+  if(exists){
+   std::string marker,ini;
+   if(!fs::is_directory(fs::symlink_status(target))||!Read(target/".botty-ultracam.json",8192,marker))throw std::runtime_error("An unmanaged UltraCam folder already exists; existing files were kept");
+   const auto previous=Settings::Json::parse(marker);
+   const auto saved=previous.at("options").get<Options>();
+   if(previous.at("schema")!=1||previous.at("version")!="1.0.1"||!Valid(saved))throw std::runtime_error("Unknown UltraCam installation; existing files were kept");
+   Managed(target);
+   for(const auto& f:kFiles)if(!Verified(target/f.path,f))throw std::runtime_error("UltraCam files were modified; existing files were kept");
