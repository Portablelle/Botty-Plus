+inline constexpr uint64_t kTitle = 0x01007EF00011E000ULL;
+inline constexpr const char* kName = "Botty UltraCam";
+struct Payload { const char* path; size_t size; const char* hash; };
+inline constexpr Payload kFiles[]{
+ {"exefs/main.npdm",1612,"7cedbb57ba93e3ab6e660490a0a7b932716854004786a2ac42d39dbf8b85e678"},
