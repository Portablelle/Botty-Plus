+ values[0]=managed&&
+           std::find(off.begin(),off.end(),kName)==off.end();
+ return values;
+}
+inline std::string Ini(const Options& v) {
+ if(!Valid(v))throw std::runtime_error("Invalid UltraCam option");
+ const int height=std::stoi(Value(v,Resolution));
+ const int width=height==720?1280:height==900?1600:height==1080?1920:2048;
+ std::ostringstream out;out<<"# UltraCam by MaxLastBreath. Settings managed by Botty for BOTW 1.6.0.\n"
+ <<"[Resolution]\nMaxFramerate = "<<Value(v,TargetFps)<<"\nMenuFPS = "<<Value(v,MenuFps)
+ <<"\nQualityImprovements = "<<Value(v,Quality)<<"\nRenderDistance = "<<Value(v,Distance)
+ <<"\nWidth = "<<width<<"\nHeight = "<<height
+ <<"\n\n[Features]\nFov = "<<Value(v,Fov)<<"\n\n[UltraCam]\nTriggerWithController = "<<Value(v,FreeCamera)
+ <<"\nAutoHideUI = "<<Value(v,HideUi)<<"\nCameraSpeed = "<<Value(v,Sensitivity)<<"\nSpeed = "<<Value(v,Speed)
+ <<"\nAnimationSmoothing = "<<Value(v,Smoothing)<<"\nAnimationFadeout = "<<Value(v,Fadeout)
+ <<"\n\n[Benchmark]\nBenchmark = "<<Value(v,Benchmark)<<"\n";return out.str();
+}
+inline void Managed(const fs::path& root) {
+ const std::set<std::string> files{"exefs/main.npdm","exefs/subsdk3","romfs/UltraCam/maxlastbreath.ini",".botty-ultracam.json"};
+ const std::set<std::string> directories{"exefs","romfs","romfs/UltraCam"};
+ std::function<void(const fs::path&)> inspect=[&](const fs::path& path) {
+  std::error_code ec;
+#if defined(__PROSPERO__)
+  const auto entries=Eden::ReadNativeDirectory(path,ec);
+  if(ec)throw std::runtime_error("Cannot inspect the UltraCam folder");
+#else
+  std::vector<fs::directory_entry> entries;
+  for(fs::directory_iterator it(path,ec),end;!ec&&it!=end;it.increment(ec))entries.push_back(*it);
+  if(ec)throw std::runtime_error("Cannot inspect the UltraCam folder");
+#endif
+  if(entries.size()>8)throw std::runtime_error("Extra files in UltraCam folder; existing files were kept");
+  for(const auto& entry:entries){
+   const auto relative=entry.path().lexically_relative(root).generic_string();
+   const auto st=entry.symlink_status();
+   if(fs::is_directory(st)&&directories.count(relative))inspect(entry.path());
+   else if(!fs::is_regular_file(st)||!files.count(relative))throw std::runtime_error("Modified UltraCam folder; existing files were kept");
+  }
+ };
