+   error.clear();return true;
+  }
+  if(values[0]&&!LoadModsEnabled(title,settings))throw std::runtime_error("Turn on this game's Mods switch before enabling UltraCam");
+  for(const auto& f:kFiles)if(!Verified(source/f.path,f))throw std::runtime_error("Bundled UltraCam verification failed; reinstall Botty");
