+};
+inline fs::path Root(const std::string& directory=AssetsPath("mods")) {
+ const auto existing=Eden::Mods::TitleFolder(directory,kTitle);
+ return fs::path(existing.empty()?Eden::Mods::TitleFolderToCreate(directory,kTitle):existing)/kName;
+}
+inline bool Compatible(uint64_t title, std::string_view version) { return title==kTitle && version=="1.6.0"; }
+inline bool Valid(const Options& values) {
+ for(size_t i=0;i<values.size();++i) if(values[i]<0 || values[i]>=kDefinitions[i].count) return false;
+ return true;
+}
+inline bool Read(const fs::path& path,size_t limit,std::string& bytes) {
+ std::error_code ec; const auto st=fs::symlink_status(path,ec);
+ if(ec || !fs::is_regular_file(st)) return false;
+ const auto size=fs::file_size(path,ec); if(ec||size>limit) return false;
+ std::ifstream in(path,std::ios::binary);bytes.resize(size);in.read(bytes.data(),std::streamsize(size));
+ return size_t(in.gcount())==size && in.peek()==std::char_traits<char>::eof();
+}
+inline bool Verified(const fs::path& path,const Payload& file) {
+ std::string bytes;if(!Read(path,file.size,bytes)||bytes.size()!=file.size)return false;
+ self_update_sha256 hash;unsigned char digest[32];self_update_sha256_start(&hash);
+ self_update_sha256_add(&hash,bytes.data(),bytes.size());self_update_sha256_finish(&hash,digest);
+ return self_update_sha256_matches(digest,file.hash);
+}
+inline void Directory(const fs::path& path) {
+ fs::path part;
+ for(const auto& name:path){part/=name;std::error_code ec;auto st=fs::symlink_status(part,ec);
+  if(!fs::exists(st)){if(!fs::create_directory(part))throw std::runtime_error("Cannot create UltraCam folder");fs::permissions(part,fs::perms::owner_all);}
+  else if(!fs::is_directory(st))throw std::runtime_error("UltraCam folder must not be a link");
+ }
+}
+inline void Write(const fs::path& path,std::string_view bytes) {
+ Directory(path.parent_path());auto temp=path.string()+".XXXXXX";std::vector<char> name(temp.begin(),temp.end());name.push_back(0);
+ const int fd=mkstemp(name.data());if(fd<0)throw std::runtime_error("Cannot stage UltraCam settings");
+ bool ok=true;size_t at=0;while(at<bytes.size()){const auto n=::write(fd,bytes.data()+at,bytes.size()-at);if(n<=0){ok=false;break;}at+=size_t(n);}
+ if(fsync(fd))ok=false;
+ if(close(fd))ok=false;
+ if(!ok||rename(name.data(),path.c_str())){unlink(name.data());throw std::runtime_error("Cannot save UltraCam settings");}
+}
+inline Options Load(const fs::path& root=Root(),const std::string& settings=SettingsFile()) {
+ auto values=kDefaults;std::string text;bool managed=false;
+ try {if(Read(root/".botty-ultracam.json",8192,text)){
+  const auto j=Settings::Json::parse(text);auto saved=j.at("options").get<Options>();
+  if(j.at("schema")==1 && j.at("version")=="1.0.1" && Valid(saved)){values=saved;managed=true;}
+ }}catch(const std::exception&){}
