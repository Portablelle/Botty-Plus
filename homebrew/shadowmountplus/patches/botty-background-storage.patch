+#ifndef SM_BOTTY_STORAGE_POLICY_H
+#define SM_BOTTY_STORAGE_POLICY_H
+#include <stdbool.h>
+#include <string.h>
+// Deliberately restricted to the known manager, never any arbitrary other app.
+static inline bool sm_botty_storage_allowed(const char *target, const char *owner,
+    int active_pid, int owner_pid, bool owner_ready, bool transitioning,
+    bool has_outgoing, bool owns_target) {
+  if (!target || !target[0] || strcmp(target, "PPSA99071") == 0 ||
+      transitioning || has_outgoing || owns_target || active_pid < 0)
+    return false;
+  if (active_pid == 0)
+    return !owner[0];
+  return strcmp(owner, "PPSA99071") == 0 && owner_ready &&
+         owner_pid > 0 && owner_pid == active_pid;
+}
+#endif
--- a/include/sm_botty_rebase.h
+++ b/include/sm_botty_rebase.h
@@ -0,0 +1,18 @@
+#ifndef SM_BOTTY_REBASE_H
+#define SM_BOTTY_REBASE_H
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include "sm_limits.h"
+// Component-boundary replacement, also used for nested PFSC image paths.
+static inline bool sm_botty_rebase(char value[MAX_PATH], const char *old_root,
+                                   const char *new_root) {
+  size_t n = strlen(old_root);
+  if (strncmp(value, old_root, n) != 0 || (value[n] && value[n] != '/')) return true;
+  char result[MAX_PATH];
+  int length = snprintf(result, sizeof(result), "%s%s", new_root, value + n);
+  if (length < 0 || (size_t)length >= sizeof(result)) return false;
+  memcpy(value, result, (size_t)length + 1);
+  return true;
+}
+#endif
