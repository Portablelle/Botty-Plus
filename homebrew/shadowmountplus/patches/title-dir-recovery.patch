+// The install bridge has mutable request slots, but its code, imports and
+// trampolines must still match our verified installation before repairing a
+// restored entry point. Never replace a foreign hook or rewrite a live cave.
+static bool installed_bridge_matches(pid_t pid) {
+  uint8_t current[SM_SHELLCORE_BRIDGE_MAX_BLOB_SIZE];
+  if (!g_hooks.bridge_size || g_hooks.bridge_size > sizeof(current) ||
+      !sm_remote_process_read(pid, g_hooks.bridge_address, current,
+                              g_hooks.bridge_size))
+    return false;
+  const uint8_t *const slots[] = {
+      sm_shellcore_bridge_install_title_id_0,
+      sm_shellcore_bridge_install_title_id_1,
+      sm_shellcore_bridge_install_dir_0,
+      sm_shellcore_bridge_install_dir_1,
+      sm_shellcore_bridge_install_armed,
+  };
+  for (size_t i = 0; i < sizeof(slots) / sizeof(slots[0]); ++i) {
+    size_t offset = 0;
+    size_t size = i == 4 ? 1 : sizeof(uint64_t);
+    if (!bridge_symbol_offset(slots[i], size, g_hooks.bridge_size, &offset))
+      return false;
+    // A previous request must have been disarmed before reattaching the hook.
+    if (i == 4 && current[offset] != 0)
+      return false;
+    memcpy(current + offset, g_hooks.expected_bridge + offset, size);
+  }
+  return memcmp(current, g_hooks.expected_bridge, g_hooks.bridge_size) == 0;
+}
+
+// Called with g_install_mutex held. A failed read is not evidence that the
+// hook disappeared and must not permanently poison the installation state.
+static bool ensure_install_hook(pid_t pid) {
+  shellcore_hook_record_t *record = &g_hooks.hooks[2];
+  uintptr_t target = g_hooks.remote.targets[SM_SHELLCORE_TARGET_INSTALL_ALL];
+  uintptr_t hook = remote_bridge_symbol(sm_shellcore_bridge_install_all_hook);
+  uint8_t expected[MAX_HOOK_PROLOGUE_SIZE], current[MAX_HOOK_PROLOGUE_SIZE];
+  size_t size = record->original_size;
+  if (!build_hook_patch(expected, hook, size))
+    return false;
+  if (!sm_remote_process_read(pid, target, current, size) &&
+      !sm_remote_process_read(pid, target, current, size)) {
+    log_debug("  [SHELLCORE] AppInstallAll hook read failed; state retained");
+    return false;
+  }
+  if (memcmp(current, expected, size) == 0) {
+    g_hooks.status = SHELLCORE_HOOKS_READY;
+    return true;
+  }
+  if (memcmp(current, record->original, size) != 0) {
+    log_debug("  [SHELLCORE] AppInstallAll has an unknown patch; repair refused");
+    return false;
+  }
+  if (!sm_remote_process_attach(pid)) {
+    log_debug("  [SHELLCORE] cannot attach for AppInstallAll repair; retry later");
+    return false;
+  }
+  bool repaired = false;
+  sm_shellcore_remote_t remote;
+  // Revalidate under process suspension, including the executable image and
+  // the entry point: neither a PID alone nor an earlier read grants ownership.
+  if (sm_shellcore_remote_resolve(pid, &remote) &&
+      remote.pid == pid && remote.image_base == g_hooks.remote.image_base &&
+      memcmp(remote.targets, g_hooks.remote.targets, sizeof(remote.targets)) == 0 &&
+      sm_remote_process_read(pid, target, current, size) &&
+      installed_bridge_matches(pid)) {
+    if (memcmp(current, expected, size) == 0) {
+      repaired = true;
+    } else if (memcmp(current, record->original, size) == 0) {
+      repaired = patch_remote_jump(pid, target, hook, size);
+      if (!repaired && !restore_remote_bytes(pid, target, record->original, size))
+        g_hooks.status = SHELLCORE_HOOKS_ROLLBACK_PENDING;
+    }
+  }
+  if (!sm_remote_process_detach(pid)) {
+    log_debug("  [SHELLCORE] detach failed after AppInstallAll repair");
+    if (!sm_remote_process_detach(pid))
+      g_hooks.status = SHELLCORE_HOOKS_ROLLBACK_PENDING;
+    return false;
+  }
+  if (repaired) {
+    g_hooks.status = SHELLCORE_HOOKS_READY;
+    log_debug("  [SHELLCORE] AppInstallAll hook recovered automatically");
+  } else {
+    log_debug("  [SHELLCORE] AppInstallAll repair validation failed; no dispatch");
+  }
+  return repaired;
+}
