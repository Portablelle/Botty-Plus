# Include inside the botty.example.com server. Prowlarr enforces X-Api-Key.
location = /botty-indexer/api/v1/search {
    if ($scheme != https) { return 403; }
    limit_except GET { deny all; }
    access_log off;
    proxy_pass http://127.0.0.1:9696/api/v1/search;
    proxy_set_header Host 127.0.0.1:9696;
    proxy_set_header Cookie "";
    proxy_read_timeout 110s;
}
# Only positive numeric indexer download routes; administration remains private.
location ~ ^/botty-indexer/([1-9][0-9]*)/download$ {
    if ($scheme != https) { return 403; }
    limit_except GET { deny all; }
    access_log off;
    proxy_pass http://127.0.0.1:9696/$1/download$is_args$args;
    proxy_set_header Host 127.0.0.1:9696;
    proxy_set_header Cookie "";
    proxy_read_timeout 110s;
}
location = /botty-indexer/artwork {
    if ($scheme != https) { return 403; }
    limit_except GET { deny all; }
    access_log off;
    proxy_pass http://127.0.0.1:9697/artwork;
    proxy_set_header Cookie "";
    proxy_read_timeout 12s;
}
