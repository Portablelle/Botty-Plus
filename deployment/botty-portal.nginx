# Replace botty.example.com and provision its certificate before enabling TLS.
server {
    listen 80;
    listen [::]:80;
    server_name botty.example.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/botty-acme;
    }
    location / { return 301 https://botty.example.com$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name botty.example.com;
    ssl_certificate /etc/letsencrypt/live/botty.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/botty.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/botty-ps5/current;
    index index.html;
    autoindex off;
    add_header Cache-Control "no-store" always;

    # Prevent config and hidden files from being served even if copied by mistake.
    location ~ (^|/)\. { deny all; }
    location ~* \.(key|p12|pfx|log)$ { deny all; }
    location / { try_files $uri $uri/ =404; }

    # Optional, after configuring the private upstream services:
    # include /etc/nginx/snippets/botty-prowlarr.conf;
}
